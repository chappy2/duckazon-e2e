{
  "name": "Duckazon e2e",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    5173,
    6080
  ],
  "portsAttributes": {
    "5173": {
      "label": "Duckazon e2e",
      "onAutoForward": "notify"
    },
    "6080": {
      "label": "Browser-Desktop (noVNC)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bun install && bunx playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "openai.chatgpt",
        "esbenp.prettier-vscode",
        "ReneSaarsoo.sql-formatter-vsc",
        "lumirelle.shell-format-rev",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-containers",
        "ms-playwright.playwright"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[javascript][javascriptreact][typescript][typescriptreact][css][scss][less][html][json][jsonc][markdown][yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[sql]": {
          "editor.defaultFormatter": "ReneSaarsoo.sql-formatter-vsc",
          "editor.formatOnSave": true
        },
        "SQL-Formatter-VSCode.dialect": "sqlite",
        "[shellscript][dockerfile]": {
          "editor.defaultFormatter": "lumirelle.shell-format-rev",
          "editor.formatOnSave": true
        },
        "shellformat.path": "/usr/bin/shfmt",
        "shellformat.effectLanguages": [
          "shellscript",
          "dockerfile"
        ],
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "webPort": "6080",
      "password": "vscode"
    }
  },
  "runArgs": [
    "--shm-size=1g"
  ]
}
